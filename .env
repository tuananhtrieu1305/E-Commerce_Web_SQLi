# ============================================================
# Docker Compose Environment Variables
# ============================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root123456
# 2 database riêng biệt — trigger/view chỉ tồn tại trong DB secure
MYSQL_DATABASE_VULNERABLE=e_commerce_vulnerable
MYSQL_DATABASE_SECURE=e_commerce_secure

# --- Backend Secure (DB user least privilege) ---
DB_PASSWORD=SecurePass@2024

# --- JWT ---
JWT_SECRET=a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9T0u1V2w3X4y5Z6

# --- Gemini API ---
GEMINI_API_KEY=AIzaSyAL9yxn2DjoPt8yQpAuoBtbI1VDtDDc-lU

# --- Frontend ---
# VITE_BACKEND_URL phải include prefix backend để proxy route đúng
# Flow: ${BACKEND_URL}/api/product = http://localhost/api/secure/api/product
#       → Proxy → LB (strip /api/secure/) → BE nhận /api/product ✓
# Dùng secure:   http://localhost/api/secure
# Dùng vuln:     http://localhost/api/vuln
VITE_BACKEND_URL=http://localhost/api/secure

# --- Proxy admin token (used by detector to call /admin/ban) ---
PROXY_ADMIN_TOKEN=ChangeThisToAStrongToken
